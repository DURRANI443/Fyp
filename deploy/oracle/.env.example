# Copy to /opt/northstar/.env and chmod 600. Replace every example value.
APP_ENV=production
APP_TIMEZONE=Asia/Karachi
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/opt/northstar/certs/supabase-ca.crt
SEED_DEMO=false
SECURE_COOKIES=true
SESSION_HOURS=12
ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
TRUSTED_HOSTS=YOUR_BACKEND_HOST,localhost,127.0.0.1
LLM_MODE=offline
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=512
# CPU-light deployment baseline. Optional MiniLM installation is a separate step.
EMBEDDING_MODE=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETURN_WINDOW_DAYS=30
CONFIRMATION_MINUTES=10
