# Copy to .env at the repository root. This file contains no secrets.
APP_ENV=development
APP_TIMEZONE=Asia/Karachi
DATABASE_URL=
# Blank DATABASE_URL uses SQLite in .local/northstar.db.
# PostgreSQL example: postgresql+psycopg://northstar:local-password@127.0.0.1:55432/northstar
SEED_DEMO=true
SECURE_COOKIES=false
SESSION_HOURS=12
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Hosting: use deploy/oracle/.env.example and DEPLOYMENT.md. Production requires
# PostgreSQL with TLS, exact HTTPS origins/hosts, secure cookies, and no demo seed.

# Offline is the default. Never put the key in frontend code or VITE_* variables.
LLM_MODE=offline
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The adapter checks fresh zero-price metadata and uses zero provider price caps.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=512

# Run locally after downloading and pinning the model revision.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODE=local
RETURN_WINDOW_DAYS=30
CONFIRMATION_MINUTES=10
